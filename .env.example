# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEMO_EMAIL=judge@spendscript.dev
DEMO_PASSWORD=

# Supabase (required for authenticated persistent mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Stable dedicated key for organization-level OpenAI/Prava credential encryption.
# Generate 32+ random characters. Never rotate it without reconnecting saved integrations.
# Local setup can fall back to the service-role key, but production should set this explicitly.
INTEGRATION_ENCRYPTION_KEY=

# Optional deployment fallbacks. Organization admins normally connect these at /settings.
# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Prava sandbox
PRAVA_BASE_URL=https://sandbox.api.prava.space
PRAVA_SECRET_KEY=
NEXT_PUBLIC_PRAVA_PUBLISHABLE_KEY=
PRAVA_CUSTOMER_ID=
